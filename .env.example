# Database
DATABASE_URL=postgresql://postgres:root@db:5432/travel_admin?schema=public

# Auth
NEXTAUTH_SECRET=replace-with-a-random-string
NEXTAUTH_URL=http://localhost:3000

# reCAPTCHA v3 (optional — leave blank to disable on enquiry form)
# RECAPTCHA_SITE_KEY and NEXT_PUBLIC_RECAPTCHA_SITE_KEY are the same site key
# read in different contexts (server vs. client-side build inlining).
RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Analytics & SEO (all optional)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# SMTP (can also be configured from Admin → Settings)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# INQUIRY_FROM=
# INQUIRY_TO=
