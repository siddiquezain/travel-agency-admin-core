# Database
POSTGRES_PASSWORD=change-me-strong-password

# NextAuth
NEXTAUTH_URL=https://new.originsoftwares.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# SMTP (Email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASS=app-password
INQUIRY_FROM="Origin Tours <noreply@origintours.example>"
INQUIRY_TO=bookings@origintours.example

# Analytics & Search Console — optional; override the built-in production
# defaults baked into src/app/layout.tsx. Leave blank to use the defaults.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# Google reCAPTCHA v3 — protects the public forms and admin login.
# Leave blank to disable (forms still work, no bot check). Get keys at
# https://www.google.com/recaptcha/admin (register a v3 / "score based" site).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
