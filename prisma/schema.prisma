generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int        @id @default(autoincrement())
  name          String?
  email         String     @unique
  passwordHash  String
  role          String     @default("ADMIN")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  blogPosts     BlogPost[]
}

model Tour {
  id                Int           @id @default(autoincrement())
  slug              String        @unique
  title             String
  description       String?
  price             String?
  originalPrice     String?
  rating            Float?
  reviewsCount      Int?
  duration          String?
  hotelName         String?
  country           String?
  itinerary         Json?
  images            Json?
  packages          Json?
  features          Json?
  mealTypes         Json?
  inclusions        Json?
  exclusions        Json?
  datesAvailability Json?
  gallery           Json?
  isActive          Boolean       @default(true)
  featured          Boolean       @default(false)
  tourCategoryId    Int?
  tourCategory      TourCategory? @relation(fields: [tourCategoryId], references: [id], onDelete: SetNull)
  destinationId     Int?
  destination       Destination?  @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([tourCategoryId])
  @@index([destinationId])
}

model Visa {
  id               Int      @id @default(autoincrement())
  slug             String   @unique
  country          String
  type             String?
  requirements     Json?
  fee              String?
  originalFee      String?
  rating           Float?
  reviewsCount     Int?
  processingTime   String?
  description      String?
  validityDuration String?
  images           Json?
  isActive         Boolean  @default(true)
  featured         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Attestation {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  type        String
  country     String?
  description String?
  fee         String?
  originalFee String?
  rating      Float?
  reviewsCount Int?
  images      Json?
  isActive    Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Country {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  code         String        @unique
  flag         String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  destinations Destination[]
}

model Destination {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  countryId   Int
  country     Country  @relation(fields: [countryId], references: [id], onDelete: Restrict)
  description String?

  // Guide content
  heroImage     String?
  gallery       Json?
  overview      String?
  sections      Json?
  attractions   Json?
  faqs          Json?
  region        String?
  bestTimeShort String?

  // SEO + presentation
  metaTitle       String?
  metaDescription String?
  featured        Boolean @default(false)
  sortOrder       Int?

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  tours     Tour[]
  blogPosts BlogPost[]

  @@index([countryId])
  @@index([featured])
}

model VisaType {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AttestationType {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TourCategory {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  tours       Tour[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id              Int       @id @default(autoincrement())
  slug            String    @unique
  title           String
  excerpt         String?
  content         String
  faqs            Json?
  featuredImage   String?
  category        String?
  metaTitle       String?
  metaDescription String?
  authorId        Int?
  author          User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  isActive        Boolean   @default(true)
  featured        Boolean   @default(false)
  publishedAt     DateTime?
  destinations    Destination[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([authorId])
  @@index([category])
}

model Currency {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  symbol    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentType {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceType {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Inquiry {
  id          Int      @id @default(autoincrement())
  name        String
  email       String?
  phone       String?
  message     String?
  serviceType String?
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id           Int      @id @default(1)
  companyName  String   @default("Origin Tours and Travels")
  tagline      String?
  supportEmail String?
  supportPhone String?
  whatsapp     String?
  addressLine  String?
  city         String?
  state        String?
  postalCode   String?
  country      String?  @default("India")

  smtpHost     String?
  smtpPort     Int?     @default(587)
  smtpUser     String?
  smtpPass     String?
  smtpSecure   Boolean  @default(false)
  inquiryFrom  String?
  inquiryTo    String?

  heroSlides     Json?
  sliderAutoplay Boolean @default(true)
  sliderInterval Int     @default(5000)
  sliderSpeed    Int     @default(600)
  sliderLoop         Boolean @default(true)
  sliderShowDots     Boolean @default(true)
  sliderShowArrows   Boolean @default(true)
  sliderPauseOnHover Boolean @default(true)

  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}
